# ─────────────────────────────────────────────────────────────
# 곁길(Gyeolkil) 환경 변수 예시
# 이 파일을 복사해 `.env.local` 로 만든 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env.local
# Vite 는 VITE_ 접두사가 붙은 변수만 클라이언트에 노출합니다.
# ⚠️ .env / .env.local 은 절대 커밋하지 마세요. (.gitignore 등록됨)
# ─────────────────────────────────────────────────────────────

# ── Firebase (콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정) ──────────
VITE_FIREBASE_API_KEY="여기에_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="프로젝트ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="프로젝트ID"
VITE_FIREBASE_STORAGE_BUCKET="프로젝트ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxx"

# ── 카카오맵 (developers.kakao.com > 내 애플리케이션 > 앱 키) ──
# JavaScript 키: 지도 렌더링용. 플랫폼 > Web 에 도메인 등록 필수.
VITE_KAKAO_JS_KEY="여기에_JAVASCRIPT_KEY"

# ── 경로 탐색 (서버 전용 비밀키) ─────────────────────────────────
# VITE_ 접두사를 붙이면 브라우저 번들에 키가 그대로 들어가므로 절대 붙이지 마세요.
# 개발 서버(vite.config.js 프록시)와 Vercel 서버리스 함수(api/route/*.js)만 읽습니다.
# 비워두면 경로 탐색이 실패하고 두 지점을 직선으로 잇습니다.

# 카카오 REST API 키 — 자동차 경로 (Kakao Mobility)
KAKAO_REST_KEY="여기에_REST_API_KEY"

# TMAP 앱키 — 보행자 경로 (openapi.sk.com)
TMAP_APP_KEY="여기에_TMAP_APP_KEY"
